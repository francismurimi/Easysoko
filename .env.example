# Easy Soko environment variables

# Flask session secret
EASY_SOKO_SECRET_KEY=

# Admin account
EASY_SOKO_ADMIN_EMAIL=
EASY_SOKO_ADMIN_PASSWORD=

# Persistent PostgreSQL database (required on Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/easysoko?sslmode=require

# Google OAuth (optional; enables Google sign-in/sign-up)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://easysoko-six.vercel.app/auth/google/callback
